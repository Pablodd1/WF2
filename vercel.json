{
  "outputDirectory": "dist",
  "framework": "vite",
  "buildCommand": "npm run build",
  "functions": {
    "api/bulk-disambiguate.js": {
      "maxDuration": 300
    },
    "api/clean-analyze.js": {
      "maxDuration": 120
    },
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(parsedWatches|enriched_refs).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/extract", "destination": "/extract.html" },
    { "source": "/extract.html", "destination": "/extract.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/batch-process",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/generate-report",
      "schedule": "0 3 * * *"
    }
  ]
}
