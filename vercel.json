{
  "outputDirectory": "dist",
  "framework": "vite",
  "buildCommand": "npm run build",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(parsedWatches|enriched_refs).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/extract.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/extract", "destination": "/extract.html" },
    { "source": "/extract.html", "destination": "/extract.html" },
    { "source": "/(.*)", "destination": "/extract.html" }
  ],
}
